# Loaded automatically by `npm start` (Node --env-file-if-exists)

# Server port
PORT=4000

# Bind address. Defaults to 127.0.0.1 (local only).
# Set to 0.0.0.0 only if you intentionally expose the app on your network —
# the API has no authentication.
HOST=127.0.0.1
# Bind address. Defaults to loopback because the API is unauthenticated.
# HOST=127.0.0.1

# LLM endpoints are configured in the UI (Notifications & Settings tab).
# Supported providers: Ollama or LM Studio. You run the model server yourself.
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=llama3.1:latest
# LMSTUDIO_HOST=http://localhost:1234/v1
