# Server port
PORT=4000

# Bind address. Defaults to loopback because the API is unauthenticated.
# HOST=127.0.0.1

# LLM endpoints are configured in the UI (Notifications & Settings tab).
# Supported providers: Ollama or LM Studio. You run the model server yourself.
# OLLAMA_HOST=http://192.168.1.152:11434
# LLM_MODEL=gemma4:latest
# LMSTUDIO_HOST=http://localhost:1234/v1
